---
import BaseLayout from "../layouts/BaseLayout.astro";
import { link } from "../lib/links";

const contacts = [
  {
    label: "01 / START A CONVERSATION",
    title: "Email",
    detail: "abhinavkumardubey9481@gmail.com",
    href: "mailto:abhinavkumardubey9481@gmail.com",
    external: false,
  },
  {
    label: "02 / PROFESSIONAL BACKGROUND",
    title: "LinkedIn",
    detail: "Experience, ideas and connections.",
    href: "https://www.linkedin.com/in/abhinavkrdubey/",
    external: true,
  },
  {
    label: "03 / CODE & PROJECTS",
    title: "GitHub",
    detail: "@abhinavkrdubey",
    href: "https://github.com/abhinavkrdubey",
    external: true,
  },
];
---
<BaseLayout
  title="Contact — Abhinav Kumar Dubey"
  description="Get in touch with Abhinav Kumar Dubey about data science, machine learning and collaboration."
>
  <div class="page-content">
    <div class="page-heading">
      <p class="eyebrow">START A CONVERSATION</p>
      <h1>Good work starts<br /><span class="serif">with a conversation.</span></h1>
      <p>
        Have a machine learning problem, a collaboration in mind,
        or a question about my work? Here’s where to find me.
      </p>
    </div>

    {contacts.map((contact) => (
      <a
        class="contact-card"
        href={contact.href}
        target={contact.external ? "_blank" : undefined}
        rel={contact.external ? "noopener noreferrer" : undefined}
      >
        <span>{contact.label}</span>
        <strong>{contact.title} ↗</strong>
        <span style="overflow-wrap:anywhere">{contact.detail}</span>
      </a>
    ))}

    <a class="contact-card" href={link("resume.pdf")} download>
      <span>04 / THE DETAILS</span>
      <strong>Download résumé ↓</strong>
      <span>Experience, education and technical skills · PDF</span>
    </a>
  </div>
</BaseLayout>
