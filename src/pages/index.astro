---
import BaseLayout from '../layouts/BaseLayout.astro';
import { link } from '../lib/links';
const projects = [
  {
    number: "01",
    category: "APPLIED MACHINE LEARNING",
    title: "Product classification at scale.",
    description:
      "Turning unstructured product descriptions into useful categories through text processing, machine learning and systematic evaluation.",
    tags: ["Python", "scikit-learn", "NLP"],
  },
  {
    number: "02",
    category: "SEMANTIC SIMILARITY",
    title: "Finding the products that belong together.",
    description:
      "Exploring how sentence embeddings can identify related products beyond exact keyword matches.",
    tags: ["Sentence Transformers", "Embeddings", "Similarity"],
  },
  {
    number: "03",
    category: "DATA QUALITY & AUTOMATION",
    title: "Making trustworthy data repeatable.",
    description:
      "Building validation workflows that surface inconsistencies and make recurring data checks easier to maintain.",
    tags: ["Python", "Validation", "Automation"],
  },
];
---
<BaseLayout>

        <section class="hero" id="home">
          <div class="hero-copy">
            <p class="eyebrow">
              <span class="dot"></span>
              DATA SCIENCE · MACHINE LEARNING · AI
            </p>

            <h1>
              From messy data<br />
              to <span class="serif">meaningful</span><br />
              <span class="blue">decisions.</span>
            </h1>

            <p class="intro">
              I’m Abhinav Kumar Dubey, a data scientist building practical
              machine learning systems and making complex problems easier
              to understand.
            </p>

            <div class="hero-actions">
              <a class="button" href="#work">Explore my work <span>↘</span></a>
              <a
                class="text-link"
                href="https://github.com/abhinavkrdubey"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub ↗
              </a>
            </div>
          </div>

          <aside class="visual" aria-label="My approach to data science">
            <div class="visual-top">
              <span>THE WAY I THINK</span>
              <span class="visual-index">AKD / 01</span>
            </div>

            <div class="orbit" aria-hidden="true">
              <div class="orbit-ring ring-one"></div>
              <div class="orbit-ring ring-two"></div>
              <div class="orbit-center">ask<br /><i>why.</i></div>
              <span class="orbit-point point-one"></span>
              <span class="orbit-point point-two"></span>
              <span class="orbit-point point-three"></span>
            </div>

            <div class="visual-bottom">
              <p>Understand the problem.<br />Build. Evaluate. Improve.</p>
              <span class="visual-arrow" aria-hidden="true">↗</span>
            </div>
          </aside>

          <div class="hero-footer">
            <span>BASED IN BENGALURU, INDIA</span>
            <span>CURIOUS BY DEFAULT. PRACTICAL BY DESIGN.</span>
          </div>
        </section>

        <section class="work section" id="work">
          <div class="section-heading">
            <div>
              <p class="eyebrow">01 / SELECTED FOCUS AREAS</p>
              <h2>Problems I <span class="serif">work on.</span></h2>
            </div>
            <p class="section-note">
              A look at the kinds of systems<br />I build and investigate.
            </p>
          </div>

          <a class="section-link" href={link("projects/")}>Explore project notes ↗</a><div class="project-grid">
            {projects.map((project) => (
              <article class="project">
                <div class="project-top">
                  <span>{project.number}</span>
                  <span class="project-symbol" aria-hidden="true">✳</span>
                </div>
                <p class="project-category">{project.category}</p>
                <h3>{project.title}</h3>
                <p class="project-description">{project.description}</p>
                <ul class="tags" aria-label="Technologies">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="section"><p class="eyebrow">FROM THE NOTEBOOK</p><h2>Building, testing, <span class="serif">learning.</span></h2><p class="intro">Technical notes on the tools I use and the questions I investigate.</p><a class="section-link" href={link("blog/")}>Read the blog ↗</a></section><section class="about section" id="about">
          <div>
            <p class="eyebrow">02 / BEHIND THE WORK</p>
            <h2>
              A scientist’s curiosity.<br />
              A builder’s <span class="serif">mindset.</span>
            </h2>
          </div>
          <div class="about-copy">
            <p>
              My work sits at the intersection of data, business questions
              and software. I’m interested in models that earn their place:
              clear baselines, careful evaluation and useful outcomes.
            </p>
            <p>
              I work across machine learning, natural language processing
              and analytics, while deepening my understanding of deep
              learning and large language models.
            </p>
            <div class="toolkit">
              <span>MY TOOLKIT</span>
              <p>
                Python / SQL / scikit-learn / PyTorch / TensorFlow /
                Sentence Transformers
              </p>
            </div>
          </div>
        </section>

        <section class="contact" id="contact">
          <p class="eyebrow">03 / START A CONVERSATION</p>
          <h2>
            Interesting problem?<br />
            <span class="serif">Let’s talk.</span>
          </h2>
          <a
            class="button"
            href="https://github.com/abhinavkrdubey"
            target="_blank"
            rel="noopener noreferrer"
          >
            Find me on GitHub <span>↗</span>
          </a>
        </section>
      
</BaseLayout>
